---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo-mark.png';
import site from '../content/site.json';

const { cta, links } = site;
const live = site.appStatus === 'live';
const stores = [
  { icon: 'apple', name: 'App Store', href: links.appStore },
  { icon: 'play', name: 'Google Play', href: links.googlePlay },
];
---
<section class="dl" id="download">
  <div class="container">
    <div class="dl__card" data-reveal="scale">
      <Image src={logo} alt="" width={160} height={160} class="dl__mark" data-spin />
      <h2 class="dl__title">{cta.title}</h2>
      <p class="dl__sub">{cta.subtitle}</p>
      <div class="stores dl__stores">
        {stores.map((s) =>
          live && s.href ? (
            <a class="store" href={s.href}>
              <Icon name={s.icon} size={26} />
              <span><small>Get it on</small><strong>{s.name}</strong></span>
            </a>
          ) : (
            <span class="store" aria-disabled="true">
              <Icon name={s.icon} size={26} />
              <span><small>Coming soon to</small><strong>{s.name}</strong></span>
            </span>
          ),
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .dl {
    padding-block: clamp(40px, 6vw, 80px) clamp(80px, 10vw, 140px);
  }
  .dl__card {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 20px;
    padding: clamp(56px, 8vw, 110px) clamp(20px, 5vw, 64px);
    border-radius: var(--radius-xl);
    background: var(--yellow);
    overflow: hidden;
  }
  .dl__card::before,
  .dl__card::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: var(--yellow-soft);
    opacity: 0.6;
  }
  .dl__card::before {
    width: 420px;
    height: 420px;
    left: -140px;
    top: -160px;
  }
  .dl__card::after {
    width: 300px;
    height: 300px;
    right: -80px;
    bottom: -140px;
  }
  .dl__card > * {
    position: relative;
    z-index: 1;
  }
  .dl__mark {
    width: clamp(88px, 10vw, 120px);
    height: auto;
    border-radius: 28%;
    box-shadow: 0 0 0 4px var(--ink), var(--shadow);
    transform: rotate(calc(var(--p, 0) * 24deg - 12deg));
  }
  .dl__title {
    font-size: clamp(2.25rem, 5.4vw, 4.25rem);
    max-width: 18ch;
    font-weight: 800;
  }
  .dl__sub {
    font-size: 1.125rem;
    color: rgba(10, 10, 10, 0.75);
  }
  .dl__stores {
    justify-content: center;
    margin-top: 8px;
  }
</style>
