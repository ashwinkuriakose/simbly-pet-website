---
import Icon from './Icon.astro';
import site from '../content/site.json';

interface Props {
  content?: { eyebrow: string; title: string; items: { q: string; a: string }[] };
}
// Defaults to the pet parent FAQ; the business page passes its own.
const faq = Astro.props.content ?? site.faq;
---
<section class="faq section" id="faq">
  <div class="container faq__grid">
    <header class="faq__head">
      <p class="eyebrow" data-reveal>{faq.eyebrow}</p>
      <h2 class="h2" data-reveal style="--d:1">{faq.title}</h2>
    </header>
    <div class="faq__list">
      {faq.items.map((item, i) => (
        <details class="qa" data-reveal style={`--d:${i}`} name="faq">
          <summary>
            <span>{item.q}</span>
            <span class="qa__icon"><Icon name="plus" size={20} /></span>
          </summary>
          <div class="qa__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .faq__head {
    display: grid;
    gap: 16px;
    position: sticky;
    top: 120px;
  }
  .faq__list {
    display: grid;
    gap: 12px;
  }
  .qa {
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--line);
    transition: background-color 0.3s;
  }
  .qa[open] {
    background: var(--yellow);
    border-color: transparent;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    cursor: pointer;
    list-style: none;
    font: 700 clamp(1.0625rem, 1.6vw, 1.25rem) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .qa__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--paper);
    transition: transform 0.4s var(--ease), background-color 0.3s, color 0.3s;
  }
  .qa[open] .qa__icon {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--yellow);
  }
  .qa__a {
    padding: 0 24px 24px;
    max-width: 62ch;
  }
  .qa[open] .qa__a {
    animation: qa-open 0.45s var(--ease);
  }
  @keyframes qa-open {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (max-width: 860px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__head {
      position: static;
    }
    summary {
      padding: 18px 18px;
    }
    .qa__a {
      padding: 0 18px 20px;
    }
  }
</style>
