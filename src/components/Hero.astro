---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Phone from './Phone.astro';
import Screen from './Screen.astro';
import site from '../content/site.json';
import dog from '../assets/pet-profile.jpg';
import cat from '../assets/cat-profile.jpg';

const { hero } = site;
const [lead, accent, tail] = hero.titleLines;
---
<section class="hero" id="top">
  <div class="container hero__copy">
    <p class="hero__badge"><Icon name="paw-print" size={16} /> {hero.eyebrow}</p>
    <h1 class="hero__title">
      <span class="hero__line" style="--i:0"><span>{lead}</span></span>
      <span class="hero__line" style="--i:1"><span><em class="hero__accent">{accent}</em> {tail}</span></span>
    </h1>
    <p class="hero__sub">{hero.subtitle}</p>
    <div class="hero__ctas">
      <a class="btn" href="#download">{hero.primaryCta} <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn--ghost" href={site.links.businessPortal}>{hero.secondaryCta} <Icon name="arrow-up-right" size={18} /></a>
    </div>
  </div>

  <!-- The stage widens and the phone rises as you scroll (--p from scripts/motion.ts). -->
  <div class="stage-wrap" data-hero-stage>
    <div class="stage">
      <span class="stage__ring stage__ring--1" aria-hidden="true"></span>
      <span class="stage__ring stage__ring--2" aria-hidden="true"></span>

      <figure class="pet pet--dog">
        <Image src={dog} alt="Illustration of a golden retriever" width={520} height={520} loading="eager" />
        <figcaption><b>Biscuit</b><small>Golden Retriever</small></figcaption>
      </figure>
      <figure class="pet pet--cat">
        <Image src={cat} alt="Illustration of a grey British Shorthair cat" width={520} height={520} loading="eager" />
        <figcaption><b>Mochi</b><small>British Shorthair</small></figcaption>
      </figure>

      <div class="stage__phone">
        <Phone label="Simbly Pet home screen showing pets, an upcoming vaccination and a confirmed grooming booking">
          <Screen screen="home" />
        </Phone>
      </div>

      <div class="chip chip--1">
        <span class="chip__ico"><Icon name="bell-ring" size={18} /></span>
        <span><b>Rabies booster</b><small>Biscuit · in 12 days</small></span>
      </div>
      <div class="chip chip--2">
        <span class="chip__ico chip__ico--green"><Icon name="check" size={18} /></span>
        <span><b>Grooming confirmed</b><small>Sat 10:00</small></span>
      </div>
      <div class="chip chip--3">
        <span class="chip__ico chip__ico--dark"><Icon name="camera" size={18} /></span>
        <span><b>New photo update</b><small>Mochi at boarding</small></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(128px, 15vw, 176px);
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(255, 187, 3, 0.22), transparent 70%),
      var(--paper);
    overflow: hidden;
  }

  /* Copy */
  .hero__copy {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--yellow-tint);
    border: 1px solid rgba(255, 187, 3, 0.5);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .hero__title {
    font-size: clamp(2.9rem, 8vw, 6.75rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 800;
    margin: 24px 0 22px;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__accent {
    position: relative;
    font-style: italic;
    padding-inline: 0.06em 0.1em;
    z-index: 0;
  }
  /* Highlighter swash behind "Simbly" */
  .hero__accent::before {
    content: '';
    position: absolute;
    inset: 0.18em -0.06em 0.02em -0.04em;
    border-radius: 0.2em 0.35em 0.25em 0.4em;
    background: var(--yellow);
    transform: rotate(-2deg);
    transform-origin: left;
    z-index: -1;
  }
  .hero__sub {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    color: var(--muted);
    max-width: 50ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  /* Stage */
  .stage-wrap {
    --p: 1;
    margin-top: clamp(48px, 7vw, 80px);
    padding-inline: calc(var(--gutter) + (1 - var(--p)) * 4vw);
  }
  :global(.motion) .stage-wrap {
    --p: 0;
  }
  .stage {
    position: relative;
    max-width: calc(var(--max) + 120px);
    height: clamp(460px, 48vw, 600px);
    margin-inline: auto;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--yellow);
    overflow: hidden;
    isolation: isolate;
  }
  .stage__ring {
    position: absolute;
    left: 50%;
    top: 58%;
    border-radius: 50%;
    border: 2px solid rgba(10, 10, 10, 0.08);
    translate: -50% -50%;
    z-index: -1;
  }
  .stage__ring--1 {
    width: 560px;
    height: 560px;
    background: rgba(255, 255, 255, 0.18);
  }
  .stage__ring--2 {
    width: 920px;
    height: 920px;
  }
  .stage__phone {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% calc(30% - var(--p) * 18%);
    z-index: 2;
  }
  .stage__phone :global(.phone) {
    --z: 1.06;
  }

  .pet {
    position: absolute;
    margin: 0;
    z-index: 1;
    width: clamp(200px, 22vw, 290px);
  }
  .pet img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 8px solid var(--paper);
    box-shadow: var(--shadow-lg);
  }
  .pet figcaption {
    position: absolute;
    bottom: 6%;
    display: grid;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    line-height: 1.2;
    font-size: 0.9375rem;
    box-shadow: var(--shadow);
    white-space: nowrap;
  }
  .pet figcaption small {
    color: var(--muted-on-dark);
    font-size: 0.75rem;
  }
  .pet--dog {
    left: 6%;
    top: 14%;
    transform: translateX(calc((1 - var(--p)) * 40px)) rotate(-6deg);
  }
  .pet--dog figcaption {
    right: -6%;
    transform: rotate(6deg);
  }
  .pet--cat {
    right: 6%;
    top: 24%;
    transform: translateX(calc((var(--p) - 1) * 40px)) rotate(5deg);
  }
  .pet--cat figcaption {
    left: -8%;
    transform: rotate(-5deg);
  }

  .chip {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 10px;
    border-radius: 18px;
    background: var(--paper);
    box-shadow: var(--shadow);
    font-size: 0.875rem;
    line-height: 1.25;
    animation: bob 6s ease-in-out infinite;
  }
  .chip b {
    display: block;
    font-weight: 700;
  }
  .chip small {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .chip__ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--yellow);
  }
  .chip__ico--dark {
    background: var(--ink);
    color: var(--yellow);
  }
  .chip__ico--green {
    background: #dcf5e6;
    color: var(--green);
  }
  .chip--1 {
    left: calc(50% - 330px);
    bottom: 22%;
  }
  .chip--2 {
    right: calc(50% - 340px);
    top: 12%;
    animation-delay: -2s;
  }
  .chip--3 {
    right: 4%;
    bottom: 8%;
    animation-delay: -4s;
  }
  @keyframes bob {
    50% {
      translate: 0 -10px;
    }
  }

  /* Entrance (only when motion is allowed) */
  :global(.motion) .hero__line > span {
    animation: rise 1.1s var(--ease) both;
    animation-delay: calc(0.1s + var(--i) * 0.12s);
  }
  :global(.motion) .hero__accent::before {
    animation: swipe 0.8s var(--ease) 0.6s both;
  }
  :global(.motion) .hero__badge,
  :global(.motion) .hero__sub,
  :global(.motion) .hero__ctas {
    animation: fade-up 0.9s var(--ease) both;
  }
  :global(.motion) .hero__sub {
    animation-delay: 0.35s;
  }
  :global(.motion) .hero__ctas {
    animation-delay: 0.45s;
  }
  :global(.motion) .stage {
    animation: fade-up 1.2s var(--ease) 0.3s both;
  }
  :global(.motion) .pet img {
    animation: pop 0.9s var(--ease) both;
    animation-delay: 0.65s;
  }
  :global(.motion) .pet--cat img {
    animation-delay: 0.8s;
  }
  :global(.motion) .chip {
    animation:
      pop 0.7s var(--ease) both,
      bob 6s ease-in-out 1.6s infinite;
  }
  :global(.motion) .chip--1 {
    animation-delay: 1s, 1.6s;
  }
  :global(.motion) .chip--2 {
    animation-delay: 1.15s, -0.4s;
  }
  :global(.motion) .chip--3 {
    animation-delay: 1.3s, -2.4s;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes swipe {
    from {
      transform: rotate(-2deg) scaleX(0);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  /* Tablet */
  @media (max-width: 1000px) {
    .chip--1 {
      left: 4%;
      bottom: 10%;
    }
    .chip--2 {
      right: 4%;
      top: 6%;
    }
    .chip--3 {
      display: none;
    }
    .pet {
      width: clamp(150px, 22vw, 200px);
      z-index: 3;
    }
    .pet--dog {
      left: 3%;
    }
    .pet--cat {
      right: 3%;
      top: 34%;
    }
  }

  /* Phones: the two pets sit side by side at the top of the stage, the phone rises beneath them. */
  @media (max-width: 640px) {
    .hero__ctas .btn {
      flex: 1 1 100%;
    }
    .stage-wrap {
      padding-inline: calc(12px + (1 - var(--p)) * 3vw);
    }
    .stage {
      height: 560px;
      border-radius: 32px 32px 0 0;
    }
    .stage__ring {
      top: 30%;
    }
    .stage__phone {
      top: 200px;
      bottom: auto;
      translate: -50% calc((1 - var(--p)) * 48px);
    }
    .stage__phone :global(.phone) {
      --z: 0.86;
    }
    .pet {
      width: 136px;
      z-index: 3;
    }
    .pet img {
      border-width: 5px;
    }
    .pet figcaption {
      bottom: -6px;
      padding: 5px 12px;
      font-size: 0.8125rem;
    }
    .pet figcaption small {
      display: none;
    }
    .pet--dog {
      left: 18px;
      top: 22px;
      transform: rotate(-5deg);
    }
    .pet--dog figcaption {
      right: auto;
      left: 50%;
      translate: -50% 0;
    }
    .pet--cat {
      right: 18px;
      top: 40px;
      transform: rotate(5deg);
    }
    .pet--cat figcaption {
      left: 50%;
      translate: -50% 0;
    }
    .chip {
      font-size: 0.8rem;
      padding: 8px 12px 8px 8px;
      gap: 8px;
    }
    .chip__ico {
      width: 30px;
      height: 30px;
    }
    .chip--1 {
      left: 10px;
      bottom: 28px;
    }
    .chip--2 {
      right: 10px;
      top: auto;
      bottom: 110px;
    }
  }
</style>
