---
// Shared layout for the legal and help pages (privacy, terms, account deletion).
// Pass the section list as `toc`; each page's sections use the same ids.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  intro: string;
  toc?: { id: string; label: string }[];
  updated?: boolean;
}
const { title, description, eyebrow = 'Legal', heading, intro, toc = [], updated = true } = Astro.props;
---
<Base title={title} description={description} keywords={[]}>
  <Nav />
  <main id="main" class="legal">
    <header class="legal__head">
      <div class:list={['container', { 'legal__wide': toc.length > 0 }]}>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="legal__title">{heading}</h1>
        <p class="legal__intro">{intro}</p>
        {updated && <p class="legal__meta">Last updated {site.company.legalUpdated} · {site.company.product}, powered by {site.company.name}</p>}
      </div>
    </header>

    <div class:list={['container legal__body', { 'legal__body--toc': toc.length > 0 }]}>
      {toc.length > 0 && (
        <nav class="legal__toc" aria-label="On this page">
          <b>On this page</b>
          <ol>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
          </ol>
        </nav>
      )}
      <article class="prose">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    background: var(--cream);
  }
  .legal__head {
    padding: clamp(132px, 16vw, 180px) 0 clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--line);
  }
  .legal__head .container {
    display: grid;
    gap: 16px;
    max-width: calc(860px + var(--gutter) * 2);
  }
  .legal__head .legal__wide {
    max-width: calc(var(--max) + var(--gutter) * 2);
  }
  .legal__title {
    font: 800 clamp(2.5rem, 6vw, 4.25rem) / 1 var(--font-display);
    letter-spacing: -0.04em;
    margin: 0;
  }
  .legal__intro {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--muted);
    margin: 0;
    max-width: 60ch;
  }
  .legal__meta {
    margin: 4px 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .legal__body {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    padding-block: clamp(40px, 6vw, 80px) clamp(64px, 9vw, 120px);
    max-width: calc(860px + var(--gutter) * 2);
  }
  .legal__body--toc {
    grid-template-columns: 240px minmax(0, 1fr);
    max-width: calc(var(--max) + var(--gutter) * 2);
  }
  .legal__toc {
    position: sticky;
    top: 112px;
    align-self: start;
    display: grid;
    gap: 12px;
    font-size: 0.9375rem;
  }
  .legal__toc b {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .legal__toc ol {
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 2px solid var(--line);
    display: grid;
    gap: 8px;
    list-style: none;
    counter-reset: toc;
  }
  .legal__toc a {
    color: var(--muted);
    text-decoration: none;
  }
  .legal__toc a:hover {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .legal__body--toc {
      grid-template-columns: 1fr;
    }
    .legal__toc {
      position: static;
      padding: 20px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
  }

  /* Long-form text */
  .prose {
    max-width: 72ch;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(section) {
    scroll-margin-top: 110px;
    padding-bottom: 8px;
  }
  .prose :global(section + section) {
    margin-top: 40px;
  }
  .prose :global(h2) {
    font: 750 clamp(1.5rem, 2.6vw, 1.875rem) / 1.15 var(--font-display);
    letter-spacing: -0.025em;
    margin: 0 0 14px;
  }
  .prose :global(h3) {
    font: 700 1.1875rem / 1.3 var(--font-display);
    margin: 24px 0 8px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose :global(.callout) {
    padding: 20px 24px;
    background: var(--yellow-tint);
    border: 1px solid rgba(255, 187, 3, 0.45);
    border-radius: var(--radius);
    margin-bottom: 32px;
  }
  .prose :global(.callout p:last-child),
  .prose :global(.callout ul:last-child) {
    margin-bottom: 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 16px;
    font-size: 0.9688rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    font-weight: 650;
  }
  .prose :global(.table-wrap) {
    overflow-x: auto;
    margin-bottom: 16px;
  }
  .prose :global(address) {
    font-style: normal;
  }
  /* Details still to be filled in before launch. */
  .prose :global(mark.fill) {
    background: #ffe08a;
    padding: 0 4px;
    border-radius: 4px;
  }
</style>
