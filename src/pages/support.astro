---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';
import site from '../content/site.json';
---
<Base title="Support · Simbly Pet" description="Get help with the Simbly Pet app: common questions, account deletion and how to contact the team.">
  <Nav />
  <main id="main" class="support">
    <header class="support__head container">
      <p class="eyebrow">Support</p>
      <h1>How can we help?</h1>
      <p>Send us a message and we'll reply by email, or find a quick answer further down.</p>
      <ul class="support__links">
        <li><a href="#contact">Contact the team</a></li>
        <li><a href="/delete-account">Delete your account</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
      </ul>
    </header>
    <Contact variant="support" />
    <Faq />
  </main>
  <Footer />
</Base>

<style>
  .support {
    background: var(--cream);
  }
  .support__head {
    display: grid;
    gap: 16px;
    padding-top: clamp(132px, 16vw, 180px);
  }
  .support__head h1 {
    font: 800 clamp(2.5rem, 6vw, 4.25rem) / 1 var(--font-display);
    letter-spacing: -0.04em;
    margin: 0;
  }
  .support__head > p:not(.eyebrow) {
    margin: 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--muted);
    max-width: 56ch;
  }
  .support__links {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .support__links a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    text-decoration: none;
    font-weight: 600;
  }
  .support__links a:hover {
    border-color: var(--ink);
  }
</style>
